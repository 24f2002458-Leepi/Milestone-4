n            s0 = s - 1\n            if s0 < N_PIX:\n                m[s0:min(s0 + l, N_PIX)] = 1\n    return m.reshape((H, W), order='F')\n\nid2idx = {k: i for i, k in enumerate(ids)}\nmasks = np.zeros((len(ids), 4, H, W), dtype=np.uint8)\nfor r in sub.itertuples(index=False):\n    masks[id2idx[r.image_id], CLASSES.index(r.defect_type)] = rle_to_mask(r.mask_rle)\n\nareas = masks.sum(axis=(2, 3))            # (1200, 4) pixels per image-class pair\npos   = areas > 0                         # positive pairs\n\n# combination string per image\ncombo = pd.Series(\n    ['clean' if not pos[i].any() else '+'.join(c for c, p in zip(CLASSES, pos[i]) if p) for i in range(len(ids))],\n    index=ids)\nvc = combo.value_counts()\n\n# 3) merge combos with < 3 images -> rare_other, 80/20 split stratified, random_state=42\ncombo_split = combo.where(combo.map(vc) >= 3, 'rare_other')\ntrain_idx, val_idx = train_test_split(np.arange(len(ids)), test_size=0.2,\n                                      stratify=combo_split.values, random_state=42)\nprint('train / val images:', len(train_idx), '/', len(val_idx))          # expect 960 / 240\nprint(vc)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-11T07:32:47.060977Z","iopub.execute_input":"2026-11-11T07:32:47.061253Z"}},"outputs":[],"execution_count":null},{"id":"ff113665","cell_type":"markdown","source":"## Question 1: Image-Level and Class-Level Imbalance","metadata":{}},{"id":"d7881f1b","cell_type":"code","source":"n_clean   = int((combo == 'clean').sum())\nn_pos_cls = [int(pos[:, k].sum()) for k in range(4)]\nn_combos  = combo.nunique()\nlargest, smallest = int(vc.max()), int(vc.min())\n\nprint('(a) clean images           :', n_clean)\nprint('(b) positives a,b,c,d      :', n_pos_cls)\nprint('(c) unique combination strs:', n_combos)\nprint('(d) largest, smallest group:', largest, smallest)\nprint()\nprint('Q1 ANSWER:', f\"{n_clean}; {', '.join(map(str, n_pos_cls))}; {n_combos}; {largest}, {smallest}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"85aa97c6","cell_type":"markdown","source":"## Question 2: Pixel-Level Imbalance and `pos_weight` (defect_b)","metadata":{}},{"id":"4860b3b1","cell_type":"code","source":"b_area   = areas[:, 1]                         # defect_b pixels per image\npos_px   = int(b_area.sum())\ntotal_px = len(ids) * N_PIX                    # 1,200 x 102,400\na_pct    = pos_px / total_px * 100\nb_mean   = b_area[b_area > 0].mean()\nc_ratio  = (total_px - pos_px) / pos_px\n\nprint(f'positive pixels = {pos_px:,} of {total_px:,}')\nprint('Q2 ANSWER:', f\"{a_pct:.4f}; {b_mean:.1f}; {round(c_ratio)}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"95f6176c","cell_type":"markdown","source":"## Question 3: Bounded Square-Root Sampling\n$w_g=\\min\\left(\\sqrt{n_{clean}/n_g},\\,5\\right)$, applied to every image in group $g$ (all 1,200 images, no merging).","metadata":{}},{"id":"03d0f7a7","cell_type":"code","source":"n_g   = vc                                          # group sizes (unmerged)\nw_g   = np.minimum(np.sqrt(vc['clean'] / n_g), 5)   # weight per group\ntot_w = float((w_g * n_g).sum())                    # sum of weights over all 1,200 images\n\na_sampler = w_g['clean'] * n_g['clean'] / tot_w * 100\na_natural = n_g['clean'] / len(ids) * 100\n\nb_groups  = [g for g in n_g.index if 'defect_b' in g]\nb_sampler = sum(w_g[g] * n_g[g] for g in b_groups) / tot_w * 1200\nb_natural = sum(n_g[g] for g in b_groups) / len(ids) * 1200\nc_enrich  = b_sampler / b_natural\nd_capped  = int((w_g >= 5 - 1e-12).sum())\n\nprint(pd.DataFrame({'n_g': n_g, 'w_g': w_g.round(4)}))\nprint('Q3 ANSWER:', f\"{a_sampler:.2f}, {a_natural:.2f}; {b_sampler:.2f}, {b_natural:.2f}; {c_enrich:.2f}; {d_capped}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"87c3cabb","cell_type":"markdown","source":"## Question 4: Warmup + Cosine Scheduler and the Stepping-Cadence Trap\n960 train images, batch 16 → 60 steps/epoch; 8 epochs = 480 steps; base LR = 3e-4; warmup 60 steps, cosine over the remaining 420.","metadata":{}},{"id":"20cd7729","cell_type":"code","source":"import torch\nBASE_LR, WARM, TOTAL = 3e-4, 60, 480\n\ndef mult(t):\n    return t / WARM if t < WARM else 0.5 * (1 + math.cos(math.pi * (t - WARM) / (TOTAL - WARM)))\n\nlr15, lr270, lr400 = (BASE_LR * mult(t) for t in (15, 270, 400))\n\n# (b) the bug: schedule defined in steps but scheduler.step() called once per epoch (8 calls in total)\np   = torch.nn.Parameter(torch.zeros(1))\nopt = torch.optim.AdamW([p], lr=BASE_LR)\nsch = torch.optim.lr_scheduler.LambdaLR(opt, lr_lambda=mult)\nfor epoch in range(8):\n    opt.step()          # (training for the epoch would happen here)\n    sch.step()          # BUG: once per epoch instead of once per optimizer step\nlr_bug = opt.param_groups[0]['lr']\n\nc_text = (\"The LR never leaves the tiny warmup range (stuck at ~4e-5, never reaching 3e-4 or decaying), \"\n          \"so the training loss falls very slowly and the LR curve is almost flat near zero.\")\nprint('Q4 ANSWER:', f\"{lr15:.2e}, {lr270:.2e}, {lr400:.2e}; {lr_bug:.2e}; {c_text}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"56d4944a","cell_type":"markdown","source":"## Question 5: Early Stopping Trace\nmode = max, patience = 3, improvement only if `score > best + min_delta`.","metadata":{}},{"id":"d479ce97","cell_type":"code","source":"scores = [0.512, 0.601, 0.648, 0.661, 0.664, 0.668, 0.671, 0.670, 0.672, 0.669, 0.673, 0.665]\n\ndef early_stop_trace(scores, patience=3, min_delta=0.0, verbose=True):\n    best, best_ep, bad, stop_ep = -1.0, None, 0, None\n    for ep, s in enumerate(scores, 1):\n        if s > best + min_delta:\n            best, best_ep, bad = s, ep, 0\n            tag = 'improved -> save'\n        else:\n            bad += 1\n            tag = f'no improvement, patience {bad}/{patience}'\n        if verbose: print(f'epoch {ep:2d}  score {s:.3f}  {tag}')\n        if bad >= patience:\n            stop_ep = ep\n            break\n    return stop_ep, best_ep, best\n\nprint('--- min_delta = 0.002 ---')\ne_stop, e_restore, s_restore = early_stop_trace(scores, 3, 0.002)\nprint('\\n--- min_delta = 0 ---')\nstop0, best0, _ = early_stop_trace(scores, 3, 0.0)\n\nprint('\\nQ5 ANSWER:', f\"{e_stop}, {e_restore}, {s_restore:.3f}; {'yes' if stop0 else 'no'}, {best0}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"fca57c25","cell_type":"markdown","source":"## Question 6: Mixed Precision, GPU Memory and Gradient Accumulation","metadata":{}},{"id":"218bef07","cell_type":"code","source":"P = 25_000_000\nstate_mb = P * 4 * 4 / 1e6                 # weights + grads + 2 AdamW moments, FP32 (4 bytes each)\nact_fp32, act_amp = 150, 150 / 2           # MB per sample\n\nmem16_fp32 = state_mb + 16 * act_fp32\nmem16_amp  = state_mb + 16 * act_amp\nbmax_fp32  = int((3400 - state_mb) // act_fp32)\nbmax_amp   = int((3400 - state_mb) // act_amp)\n\n# Part B\nN_TRAIN, MICRO, ACCUM = 960, 8, 4\neff_bs     = MICRO * ACCUM\nmicro_per_epoch = math.ceil(N_TRAIN / MICRO)\nsteps_per_epoch = math.ceil(N_TRAIN / eff_bs)\nprint('partial micro-batch? ', N_TRAIN % MICRO != 0, '| partial optimizer batch?', N_TRAIN % eff_bs != 0)\nloss_div   = ACCUM\nwarm_steps = 2 * steps_per_epoch\n\nprint('Q6 ANSWER:', f\"{state_mb:.0f}; {mem16_fp32:.0f}, {mem16_amp:.0f}; {bmax_fp32}, {bmax_amp}; \"\n                    f\"{eff_bs}; {micro_per_epoch}, {steps_per_epoch}; {loss_div}; {warm_steps}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"8193d40e","cell_type":"markdown","source":"## Question 7: The Naive Dice Trap and the Official Metric\nMetric helpers (reused in the training questions). Everything works from per-pair statistics:\n`inter = |P∩G|`, `psum = |P|`, `gsum = |G|`.","metadata":{}},{"id":"31bfbd70","cell_type":"code","source":"def official_score(inter, psum, gsum):\n    inter, psum, gsum = map(np.asarray, (inter, psum, gsum))\n    is_pos = gsum > 0\n    fg  = (2 * inter[is_pos] / (psum[is_pos] + gsum[is_pos])).mean() if is_pos.any() else 0.0\n    emp = ~is_pos\n    fps = 1 - (psum[emp] / N_PIX).mean() if emp.any() else 1.0\n    ea  = (psum[emp] == 0).mean()      if emp.any() else 1.0\n    return 0.70 * fg + 0.20 * fps + 0.10 * ea\n\ndef naive_dice(inter, psum, gsum):\n    inter, psum, gsum = map(np.asarray, (inter, psum, gsum))\n    d = np.where((psum + gsum) == 0, 1.0, 2 * inter / np.maximum(psum + gsum, 1))   # Dice(empty,empty)=1\n    return d.mean()\n\n# ---- Part A: all-empty baseline on all 4,800 pairs\ng_all   = areas.reshape(-1)\np_all   = np.zeros_like(g_all)\ni_all   = np.zeros_like(g_all)\na7  = int((g_all == 0).sum())\nb7  = naive_dice(i_all, p_all, g_all)\nc7  = official_score(i_all, p_all, g_all)\n\n# ---- Part B: toy set (400 pairs: 60 positive @ FG-Dice 0.50, 340 empty; 34 empty pairs get a 1,024-px blob)\nfg_toy, n_pos, n_emp, n_fp, blob = 0.50, 60, 340, 34, 1024\nfps_toy = 1 - (n_fp * blob / N_PIX) / n_emp\nea_toy  = (n_emp - n_fp) / n_emp\nofficial_toy = 0.70 * fg_toy + 0.20 * fps_toy + 0.10 * ea_toy\nnaive_toy    = (n_pos * fg_toy + (n_emp - n_fp) * 1.0 + n_fp * 0.0) / (n_pos + n_emp)\nbase_naive_toy    = n_emp / (n_pos + n_emp)\nbase_official_toy = 0.70 * 0 + 0.20 * 1 + 0.10 * 1\nprint(f'toy: official={official_toy:.4f} naive={naive_toy:.4f} | all-empty baseline: naive={base_naive_toy:.4f} official={base_official_toy:.4f}')\ne_metric = 'Naive Dice' if naive_toy < base_naive_toy else 'Official score'\n\nprint('Q7 ANSWER:', f\"{a7}; {b7:.4f}, {c7:.4f}; {official_toy:.4f}, {naive_toy:.4f}; {e_metric}, {base_naive_toy:.4f}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"9f678428","cell_type":"markdown","source":"## Question 9: Defect-Size Binning and Presence vs. Overlap","metadata":{}},{"id":"f068abc1","cell_type":"code","source":"pair_area = areas[pos]                                     # all positive pairs, 4 classes pooled\nbins = {'1-100': (1, 100), '101-500': (101, 500), '501+': (501, 10**9)}\ncnt  = {k: int(((pair_area >= lo) & (pair_area <= hi)).sum()) for k, (lo, hi) in bins.items()}\npx_l = int(pair_area[pair_area >= 501].sum())\nb9   = px_l / pair_area.sum() * 100\n\nrecall = {'1-100': 0.30, '101-500': 0.70, '501+': 0.95}\nmissed = {k: cnt[k] * (1 - recall[k]) for k in cnt}\nc_total = sum(missed.values())\nc_bin   = max(missed, key=missed.get)\n\nprint('pairs per bin :', cnt)\nprint('missed per bin:', {k: round(v, 2) for k, v in missed.items()})\nd_text = (\"Missed pairs count every pair equally, whereas missed pixels weight each pair by its area, so many small defects \"\n          \"can dominate the missed-pair count while a few large defects hold most of the missed pixels.\")\nprint('Q9 ANSWER:', f\"{cnt['1-100']}, {cnt['101-500']}, {cnt['501+']}; {b9:.2f}; {c_total:.2f}, {c_bin}; {d_text}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"ff6a6443","cell_type":"markdown","source":"## Training setup (for Q8 and Q10)","metadata":{}},{"id":"a8474293","cell_type":"code","source":"import copy, torch.nn as nn, torch.nn.functional as F\nfrom torch.utils.data import DataLoader, TensorDataset, WeightedRandomSampler\nfrom PIL import Image\nimport matplotlib.pyplot as plt\n\ndevice = 'cuda' if torch.cuda.is_available() else 'cpu'\nUSE_AMP = device == 'cuda'\nIMG_ROOT = '/kaggle/input'\nEPOCHS, BATCH, LR, THRESH = 6, 16, 3e-4, 0.5\nPROJECT = f'{ROLL_NO}-t32026'\n\n# ---- W&B login (Kaggle secret named WANDB_API_KEY)\nimport wandb\ntry:\n    from kaggle_secrets import UserSecretsClient\n    wandb.login(key=UserSecretsClient().get_secret('WANDB_API_KEY'))\nexcept Exception as e:\n    print('W&B login via Kaggle secret failed -> running offline:', e)\n    os.environ['WANDB_MODE'] = 'offline'\n\n# ---- locate + cache images\nimg_paths = {}\nfor root, _, files in os.walk(IMG_ROOT):\n    for f in files:\n        if f.lower().endswith(('.jpg', '.jpeg', '.png', '.bmp')):\n            img_paths[os.path.splitext(f)[0]] = os.path.join(root, f)\nmissing = [i for i in ids if i not in img_paths]\nassert not missing, f'{len(missing)} images not found under {IMG_ROOT}, e.g. {missing[:3]}'\n\ndef load_rgb(image_id):\n    arr = np.asarray(Image.open(img_paths[image_id]).convert('RGB'))\n    assert arr.shape[:2] == (H, W), f'unexpected image shape {arr.shape}'\n    return arr.transpose(2, 0, 1)\n\nimages_t = torch.from_numpy(np.stack([load_rgb(i) for i in ids]))     # (1200, 3, 128, 800) uint8\nmasks_t  = torch.from_numpy(masks)                                    # (1200, 4, 128, 800) uint8\nprint('cached:', tuple(images_t.shape), tuple(masks_t.shape), '| device:', device)\n\n# ---- model\ndef conv_block(i, o):\n    return nn.Sequential(nn.Conv2d(i, o, 3, padding=1, bias=False), nn.BatchNorm2d(o), nn.ReLU(inplace=True),\n                         nn.Conv2d(o, o, 3, padding=1, bias=False), nn.BatchNorm2d(o), nn.ReLU(inplace=True))\n\nclass UNet(nn.Module):\n    def __init__(self, in_ch=3, out_ch=4, base=16):\n        super().__init__()\n        c = [base, base * 2, base * 4, base * 8, base * 16]\n        self.enc = nn.ModuleList([conv_block(in_ch, c[0]), conv_block(c[0], c[1]), conv_block(c[1], c[2]), conv_block(c[2], c[3])])\n        self.mid = conv_block(c[3], c[4])\n        self.up  = nn.ModuleList([nn.ConvTranspose2d(c[4], c[3], 2, 2), nn.ConvTranspose2d(c[3], c[2], 2, 2),\n                                  nn.ConvTranspose2d(c[2], c[1], 2, 2), nn.ConvTranspose2d(c[1], c[0], 2, 2)])\n        self.dec = nn.ModuleList([conv_block(c[3] * 2, c[3]), conv_block(c[2] * 2, c[2]),\n                                  conv_block(c[1] * 2, c[1]), conv_block(c[0] * 2, c[0])])\n        self.head = nn.Conv2d(c[0], out_ch, 1)\n    def forward(self, x):\n        skips = []\n        for e in self.enc:\n            x = e(x); skips.append(x); x = F.max_pool2d(x, 2)\n        x = self.mid(x)\n        for up, dec, s in zip(self.up, self.dec, reversed(skips)):\n            x = dec(torch.cat([up(x), s], dim=1))\n        return self.head(x)\n\ncriterion = nn.BCEWithLogitsLoss()\n\ndef set_seed(seed):\n    random.seed(seed); np.random.seed(seed); torch.manual_seed(seed); torch.cuda.manual_seed_all(seed)\n\n@torch.no_grad()\ndef evaluate(model, loader):\n    model.eval()\n    tot_loss, n, I, P, G = 0.0, 0, [], [], []\n    for xb, yb in loader:\n        x = xb.to(device).float() / 255; y = yb.to(device).float()\n        with torch.autocast(device_type='cuda', enabled=USE_AMP):\n            logits = model(x)\n        tot_loss += criterion(logits.float(), y).item() * x.size(0); n += x.size(0)\n        pred = torch.sigmoid(logits.float()) > THRESH\n        gt = y > 0.5\n        I.append((pred & gt).sum((2, 3)).cpu()); P.append(pred.sum((2, 3)).cpu()); G.append(gt.sum((2, 3)).cpu())\n    I, P, G = (torch.cat(t).numpy().reshape(-1) for t in (I, P, G))      # per image-class pair\n    empty = G == 0\n    return dict(val_loss=tot_loss / n, val_score=official_score(I, P, G), val_naive=naive_dice(I, P, G),\n                false_alarm_pct=100 * (P[empty] > 0).mean())\n\ndef make_loaders(use_sampler, seed):\n    tr_ds = TensorDataset(images_t[train_idx], masks_t[train_idx])\n    va_ds = TensorDataset(images_t[val_idx],  masks_t[val_idx])\n    g = torch.Generator().manual_seed(seed)\n    if use_sampler:                          # bounded sqrt sampler, weights computed on the TRAIN images only\n        tr_combo = combo.iloc[train_idx]\n        n_tr = tr_combo.value_counts()\n        w_tr = np.minimum(np.sqrt(n_tr['clean'] / n_tr), 5)\n        sample_w = torch.tensor(tr_combo.map(w_tr).values, dtype=torch.double)\n        sampler = WeightedRandomSampler(sample_w, num_samples=len(tr_ds), replacement=True, generator=g)\n        tr_loader = DataLoader(tr_ds, batch_size=BATCH, sampler=sampler)\n    else:\n        tr_loader = DataLoader(tr_ds, batch_size=BATCH, shuffle=True, generator=g)\n    return tr_loader, DataLoader(va_ds, batch_size=BATCH, shuffle=False)\n\ndef run_experiment(name, seed=42, use_sched=False, use_sampler=False):\n    set_seed(seed)\n    run = wandb.init(project=PROJECT, name=name, reinit=True,\n                     config=dict(seed=seed, warmup_cosine=use_sched, sqrt_sampler=use_sampler, amp=USE_AMP, epochs=EPOCHS,\n                                 batch_size=BATCH, lr=LR, threshold=THRESH, train_images=len(train_idx), val_images=len(val_idx)))\n    tr_loader, va_loader = make_loaders(use_sampler, seed)\n    model = UNet().to(device)\n    opt = torch.optim.AdamW(model.parameters(), lr=LR)\n    steps_per_epoch = len(tr_loader)\n    warm, total = steps_per_epoch, EPOCHS * steps_per_epoch          # 60 and 360 for 960 images\n    lam = (lambda t: t / warm if t < warm else 0.5 * (1 + math.cos(math.pi * (t - warm) / (total - warm)))) if use_sched else (lambda t: 1.0)\n    sched = torch.optim.lr_scheduler.LambdaLR(opt, lr_lambda=lam)\n    scaler = torch.cuda.amp.GradScaler(enabled=USE_AMP)\n    hist, best = [], dict(score=-1, epoch=None, state=None, row=None)\n    for ep in range(1, EPOCHS + 1):\n        model.train(); tl, n = 0.0, 0\n        for xb, yb in tr_loader:\n            x = xb.to(device).float() / 255; y = yb.to(device).float()\n            opt.zero_grad(set_to_none=True)\n            with torch.autocast(device_type='cuda', enabled=USE_AMP):\n                logits = model(x)\n            loss = criterion(logits.float(), y)\n            scaler.scale(loss).backward(); scaler.step(opt); scaler.update()\n            sched.step()                                              # once per OPTIMIZER STEP (not per epoch)\n            tl += loss.item() * x.size(0); n += x.size(0)\n        row = dict(epoch=ep, train_loss=tl / n, lr=opt.param_groups[0]['lr'], **evaluate(model, va_loader))\n        row['gap'] = row['val_loss'] - row['train_loss']\n        hist.append(row); wandb.log(row)\n        if row['val_score'] > best['score']:                          # keep best checkpoint by OFFICIAL score\n            best.update(score=row['val_score'], epoch=ep, state=copy.deepcopy(model.state_dict()), row=row)\n        print(f\"[{name}] ep{ep} train {row['train_loss']:.4f} val {row['val_loss']:.4f} score {row['val_score']:.4f} \"\n              f\"naive {row['val_naive']:.4f} FA% {row['false_alarm_pct']:.1f}\")\n    torch.save(best['state'], f'{name}_best.pt')\n    wandb.summary.update(best_val_score=best['score'], best_epoch=best['epoch'], false_alarm_pct_best=best['row']['false_alarm_pct'])\n    run.finish()\n    return pd.DataFrame(hist), best\n\nresults = {}","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"cf5a587c","cell_type":"markdown","source":"## Question 8: Training Dynamics and Checkpoint Selection\nBaseline + warmup/cosine schedule (Q4), natural sampling, seed 42, 6 epochs.\nThis same run is also **R1** in Question 10 (R0 + warmup/cosine only), so it is trained once and reused.","metadata":{}},{"id":"32398db1","cell_type":"code","source":"hist_q8, best_q8 = run_experiment('Q8_R1_warmup_cosine', seed=42, use_sched=True, use_sampler=False)\nresults['R1'] = (hist_q8, best_q8)\ndisplay(hist_q8.round(4))\n\nfig, ax = plt.subplots(1, 2, figsize=(11, 3.6))\nax[0].plot(hist_q8.epoch, hist_q8.train_loss, 'o-', label='train loss'); ax[0].plot(hist_q8.epoch, hist_q8.val_loss, 's-', label='val loss')\nax[0].set_xlabel('epoch'); ax[0].set_title('Learning curves (loss)'); ax[0].legend()\nax[1].plot(hist_q8.epoch, hist_q8.val_score, 'o-', color='green'); ax[1].set_xlabel('epoch'); ax[1].set_title('Official validation score')\nplt.tight_layout(); plt.show()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"ceefaf63","cell_type":"code","source":"a8      = int(hist_q8.loc[hist_q8.val_loss.idxmin(), 'epoch'])\nb8_ep   = int(hist_q8.loc[hist_q8.val_score.idxmax(), 'epoch'])\nb8_sc   = hist_q8.val_score.max()\nc8      = hist_q8.loc[hist_q8.epoch == 6, 'gap'].item()\n\n# hint for (d): read the curves above and confirm before submitting\nt